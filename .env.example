# AccessVault environment variables
# Copy this file to .env.local and fill in the placeholders.
# These values are public by design (they ship to the browser). They are NOT secret keys.

# Supabase project URL, from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon public key, from Project Settings → API → anon public.
# The anon key is safe to expose only because Row Level Security is enabled.
# NEVER put the service-role key here or in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Canonical app URL. Used for email verification and password-reset redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Do not add SUPABASE_SERVICE_ROLE_KEY to this project.
# AccessVault does not use a service-role key. Adding one to the browser would bypass RLS.
